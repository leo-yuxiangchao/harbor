---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  showDescription?: boolean;
}
const { project, showDescription = false } = Astro.props;
const { title, tagline, description, status, tech, updated } = project.data;
const isLive = status.includes('已投入使用');
const index = String(project.data.order).padStart(2, '0');
---

<article class="card">
  <div class="top">
    <span class="idx">{index}</span>
    <span class:list={['status', isLive ? 'status--live' : 'status--dev']}>{status}</span>
  </div>
  <h3 class="name"><a href={`/projects/${project.id}/`}>{title}</a></h3>
  <p class="desc">{showDescription ? description : tagline}</p>
  <div class="chips">
    {tech.slice(0, 4).map((t) => <span class="chip">{t}</span>)}
  </div>
  <div class="foot">
    <a class="more" href={`/projects/${project.id}/`}>详情 →</a>
    <span class="upd">updated {updated.slice(5)}</span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 24px 24px 20px;
    overflow: hidden;
    transition: transform .18s, border-color .18s, box-shadow .18s;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2.5px;
    background: linear-gradient(90deg, var(--accent), var(--cyan));
    opacity: 0;
    transition: opacity .18s;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: rgba(37, 99, 235, .5);
    box-shadow: var(--card-shadow-hover);
  }
  .card:hover::before { opacity: 1; }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .idx { font-family: var(--font-mono); font-size: 13px; color: var(--dim); }
  .name { margin: 14px 0 0; font-size: 19px; font-weight: 800; letter-spacing: -.01em; }
  .name a { color: var(--ink); text-decoration: none; }
  .name a:hover { color: var(--accent); }
  .desc { margin: 8px 0 0; font-size: 13.5px; color: var(--muted); flex: 1; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .more { color: var(--accent); font-weight: 600; text-decoration: none; }
  .upd { color: var(--dim); }
</style>
