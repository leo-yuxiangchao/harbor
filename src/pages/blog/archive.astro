---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))].sort((a, b) => b - a);
const byYear = (y: number) => posts.filter((p) => p.data.date.getFullYear() === y);
const fmt = (d: Date) => d.toISOString().slice(5, 10);
---

<Base title="归档">
  <div class="container">
    <section class="page-head reveal">
      <div class="sec-head" style="margin-bottom:14px">
        <span class="idx">02 /</span><h2 style="font-size:clamp(1.8rem,4.5vw,2.4rem)">归档</h2><span class="rule"></span>
        <div class="head-links">
          <a class="more" href="/blog/">文章</a>
          <a class="more" href="/blog/tags/">标签</a>
        </div>
      </div>
      <p class="desc">全部 {posts.length} 篇，按年份排列。</p>
    </section>

    <div class="archive reveal">
      {years.map((y) => (
        <section class="year-block">
          <h3 class="year">{y}</h3>
          <div class="rows">
            {byYear(y).map((p) => (
              <div class="row">
                <time>{fmt(p.data.date)}</time>
                <a class="title" href={`/blog/${p.id}/`}>{p.data.title}</a>
                {p.data.category && (
                  <a class="cat" href={`/blog/?tag=${encodeURIComponent(p.data.category)}`}>{p.data.category}</a>
                )}
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  .page-head { padding-top: clamp(48px, 8vh, 80px); }
  .desc { margin: 0; color: var(--muted); }
  .head-links { display: flex; gap: 16px; margin-left: auto; }
  .archive { margin-top: 36px; display: flex; flex-direction: column; gap: 40px; }
  .year {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 800;
    color: var(--accent);
  }
  .rows {
    border: 1px solid var(--line); border-radius: 12px;
    background: var(--card); overflow: hidden;
  }
  .row {
    display: flex; align-items: center; gap: 18px;
    padding: 14px 22px;
    transition: background .15s;
  }
  .row + .row { border-top: 1px solid var(--line); }
  .row:hover { background: var(--accent-soft); }
  time {
    font-family: var(--font-mono); font-size: 12.5px;
    color: var(--dim); min-width: 48px;
    font-variant-numeric: tabular-nums;
  }
  .title { flex: 1; font-size: 14.5px; font-weight: 600; color: var(--ink); text-decoration: none; }
  .title:hover { color: var(--accent); }
  .cat {
    font-family: var(--font-mono); font-size: 11.5px; color: var(--dim);
    border: 1px solid var(--line); border-radius: 6px; padding: 2px 9px;
    text-decoration: none;
  }
  .cat:hover { color: var(--accent); border-color: var(--accent); }
</style>
