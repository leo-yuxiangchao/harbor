---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const counts = new Map<string, number>();
for (const p of posts) {
  const c = p.data.category;
  if (c) counts.set(c, (counts.get(c) ?? 0) + 1);
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<Base title="标签">
  <div class="container">
    <section class="page-head reveal">
      <div class="sec-head" style="margin-bottom:14px">
        <span class="idx">02 /</span><h2 style="font-size:clamp(1.8rem,4.5vw,2.4rem)">标签</h2><span class="rule"></span>
        <div class="head-links">
          <a class="more" href="/blog/">文章</a>
          <a class="more" href="/blog/archive/">归档</a>
        </div>
      </div>
      <p class="desc">点分类直达文章列表并自动筛选。</p>
    </section>

    <div class="tags reveal">
      {tags.map(([tag, count]) => (
        <a class="tag" href={`/blog/?tag=${encodeURIComponent(tag)}`}>
          <span class="name">{tag}</span>
          <span class="count">{count}</span>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .page-head { padding-top: clamp(48px, 8vh, 80px); }
  .desc { margin: 0; color: var(--muted); }
  .head-links { display: flex; gap: 16px; margin-left: auto; }
  .tags { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 12px; }
  .tag {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--card); border: 1px solid var(--line);
    border-radius: 10px; padding: 10px 18px;
    color: var(--ink); text-decoration: none;
    transition: transform .15s, border-color .15s, box-shadow .15s;
  }
  .tag:hover {
    transform: translateY(-2px);
    border-color: rgba(37, 99, 235, .5);
    box-shadow: var(--card-shadow-hover);
  }
  .name { font-size: 14.5px; font-weight: 600; }
  .count {
    font-family: var(--font-mono); font-size: 11.5px; font-weight: 700;
    color: var(--accent); background: var(--accent-soft);
    border-radius: 6px; padding: 1px 8px;
  }
</style>
