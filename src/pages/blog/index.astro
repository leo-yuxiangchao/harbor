---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<Base title="文章">
  <div class="container">
    <section class="page-head reveal">
      <div class="sec-head" style="margin-bottom:14px">
        <span class="idx">02 /</span><h2 style="font-size:clamp(2rem,5vw,2.8rem)">文章</h2><span class="rule"></span>
      </div>
      <p class="desc">做项目的过程和想法，写下来。</p>
    </section>
    <div class="posts reveal">
      {posts.map((p) => (
        <a class="post" href={`/blog/${p.id}/`}>
          <time>{fmt(p.data.date)}</time>
          <span class="title-wrap">
            <span class="title">{p.data.title}</span>
            <span class="summary">{p.data.summary}</span>
          </span>
          {p.data.category && <span class="cat">{p.data.category}</span>}
          <span class="arrow">→</span>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .page-head { padding-top: clamp(48px, 8vh, 80px); }
  .desc { margin: 0; color: var(--muted); }
  .posts {
    margin-top: 32px;
    border: 1px solid var(--line); border-radius: 12px;
    background: var(--card); overflow: hidden;
  }
  .post {
    display: flex; align-items: center; gap: 22px;
    padding: 19px 24px;
    color: var(--ink); text-decoration: none;
    transition: background .15s;
  }
  .post + .post { border-top: 1px solid var(--line); }
  .post:hover { background: var(--accent-soft); }
  time {
    font-family: var(--font-mono); font-size: 12.5px;
    color: var(--dim); min-width: 92px;
    font-variant-numeric: tabular-nums;
  }
  .title-wrap { flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .title { font-size: 15.5px; font-weight: 600; }
  .summary {
    font-size: 13px; color: var(--muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .cat {
    font-family: var(--font-mono); font-size: 11.5px; color: var(--dim);
    border: 1px solid var(--line); border-radius: 6px; padding: 2px 9px;
  }
  .arrow { color: var(--dim); transition: transform .15s, color .15s; }
  .post:hover .arrow { transform: translateX(3px); color: var(--accent); }
  @media (max-width: 640px) {
    .post { gap: 12px; padding: 16px; }
    .summary, .cat { display: none; }
  }
</style>
