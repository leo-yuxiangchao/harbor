---
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toISOString().slice(0, 10);

// 上/下篇(按时间倒序:idx 越小越新)
const sorted = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const idx = sorted.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? sorted[idx - 1] : null;
const older = idx < sorted.length - 1 ? sorted[idx + 1] : null;
---

<Base title={post.data.title} description={post.data.summary}>
  <div class="container">
    <article class="post reveal">
      <a class="back" href="/blog/">← 全部文章</a>
      <header class="head">
        <h1>{post.data.title}</h1>
        <div class="meta">
          <time>{fmt(post.data.date)}</time>
          {post.data.category && <span class="cat">{post.data.category}</span>}
        </div>
      </header>
      <div class="prose">
        <Content />
      </div>

      <nav class="pn" aria-label="上下篇">
        {newer ? (
          <a class="pn-link" href={`/blog/${newer.id}/`}>
            <span class="pn-label">← 较新一篇</span>
            <span class="pn-title">{newer.data.title}</span>
          </a>
        ) : <span />}
        {older && (
          <a class="pn-link right" href={`/blog/${older.id}/`}>
            <span class="pn-label">较早一篇 →</span>
            <span class="pn-title">{older.data.title}</span>
          </a>
        )}
      </nav>

      <Comments />
    </article>
  </div>
</Base>

<style>
  .post { padding-top: clamp(40px, 7vh, 64px); max-width: 720px; }
  .back {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover { color: var(--ink); }
  .head { margin: 26px 0 12px; }
  h1 {
    margin: 0;
    font-size: clamp(1.7rem, 4.5vw, 2.3rem);
    font-weight: 800;
    letter-spacing: -.025em;
    line-height: 1.3;
  }
  .meta { display: flex; align-items: center; gap: 12px; margin-top: 16px; }
  time {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .cat {
    font-family: var(--font-mono); font-size: 11.5px; color: var(--dim);
    border: 1px solid var(--line); border-radius: 6px; padding: 2px 9px;
  }
  .prose { margin-top: 30px; }

  .pn {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .pn-link {
    display: flex; flex-direction: column; gap: 4px;
    max-width: 46%;
    color: var(--ink); text-decoration: none;
  }
  .pn-link.right { margin-left: auto; text-align: right; }
  .pn-label {
    font-family: var(--font-mono); font-size: 12px; color: var(--dim);
  }
  .pn-title {
    font-size: 14.5px; font-weight: 600;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .pn-link:hover .pn-title { color: var(--accent); }
</style>
