---
import Base from '../layouts/Base.astro';
---

<Base title="页面不存在">
  <div class="container">
    <section class="nf reveal">
      <span class="code">404</span>
      <h1>这个页面不存在</h1>
      <p class="desc">链接可能过期了，或者地址输错了。</p>
      <div class="cta">
        <a class="btn btn-primary" href="/">回首页 →</a>
        <a class="btn btn-ghost" href="/projects/">看看项目</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .nf {
    padding: clamp(120px, 20vh, 200px) 0 40px;
    max-width: 560px;
  }
  .code {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 6px;
    padding: 3px 12px;
  }
  h1 {
    margin: 22px 0 0;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -.03em;
  }
  .desc { margin: 14px 0 0; color: var(--muted); }
  .cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
</style>
